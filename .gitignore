# ---------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases

# ---------------------------------------------------------------
# Build output
# Remove this block if you prefer to commit built files, as the
# original repository did.
# ---------------------------------------------------------------
dist/
vite.config.ts.timestamp-*
*.local.vite.config.ts

# TypeScript incremental build info
*.tsbuildinfo

# Generic build caches
.turbo/
.cache/
.eslintcache

# ---------------------------------------------------------------
# Test and coverage output
# ---------------------------------------------------------------
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
playwright/.cache/
.vitest/

# ---------------------------------------------------------------
# Environment and secrets — never commit
# ---------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# ---------------------------------------------------------------
# Local data
# This app is local-first and keeps documents in IndexedDB, but
# local scratch databases are ignored in case of future tooling.
# ---------------------------------------------------------------
.data/
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal

# ---------------------------------------------------------------
# Logs
# ---------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------
# OS clutter
# ---------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
*~

# ---------------------------------------------------------------
# Editors and IDEs
# ---------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*.swn
.cursor/
.fleet/
